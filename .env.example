# Copy to .env and fill in values for local development
# (Not needed for docker compose — those values are set in docker-compose.yml)

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/hnapp

# Ollama base URL (when running Ollama locally, not via Docker)
OLLAMA_BASE_URL=http://localhost:11434

# Default Ollama model — change to any model you have installed
# Small models that fit in 8GB RAM: llama3.2:3b, qwen2.5:3b, phi3.5:mini
# Larger models for GPU: llama3.1:8b, mistral:7b, qwen2.5:7b
OLLAMA_MODEL=llama3.2:3b
