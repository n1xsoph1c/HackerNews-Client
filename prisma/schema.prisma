generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Bookmark {
  id           Int      @id @default(autoincrement())
  storyId      Int      @unique
  title        String
  url          String?
  author       String
  points       Int      @default(0)
  commentCount Int      @default(0)
  hnUrl        String
  createdAt    DateTime @default(now())
}

model Summary {
  id           Int      @id @default(autoincrement())
  storyId      Int      @unique
  // Legacy fields — kept for old cached rows
  keyPoints    String[]
  sentiment    String
  summary      String
  // Rich fields — null means old format, triggers re-generation on next request
  overview     String?
  insights     Json?
  worthReading Json?
  verdict      String?
  model        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model StoryCache {
  storyId      Int      @id
  storyJson    Json
  commentsJson Json
  fetchedAt    DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
